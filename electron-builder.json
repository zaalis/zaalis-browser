{
  "appId": "com.zaalis.browser",
  "productName": "zaalis Browser",
  "electronDist": "node_modules/electron/dist",
  "electronVersion": "43.5.0",
  "directories": {
    "output": "dist"
  },
  "afterPack": "scripts/after-pack.js",
  "files": [
    "main.js",
    "preload-chrome.js",
    "preload-content.js",
    "interface/**/*",
    "assets/**/*",
    "package.json"
  ],
  "win": {
    "icon": "assets/zaalis.ico",
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "zaalisBrowser-${version}-setup.${ext}",
    "installerSidebar": "assets/installer-sidebar.bmp",
    "installerIcon": "assets/zaalis.ico",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "zaalis Browser",
    "deleteAppDataOnUninstall": false
  }
}
