{
  "appId": "com.zaalis.browser",
  "productName": "zaalis browser",
  "directories": {
    "output": "dist"
  },
  "afterPack": "scripts/afterPack.js",
  "files": [
    "main.js",
    "preload-chrome.js",
    "preload-content.js",
    "interface/**/*",
    "assets/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.utilities",
    "icon": "assets/icon.icns",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Le micro est utilisé par le mode vocal pour converser avec l'IA, entièrement en local."
    },
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] }
    ],
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "zaalis browser",
    "artifactName": "zaalisBrowser-${version}-${arch}.dmg",
    "window": {
      "width": 680,
      "height": 420
    },
    "iconSize": 96,
    "contents": [
      { "x": 185, "y": 210 },
      { "x": 495, "y": 210, "type": "link", "path": "/Applications" }
    ]
  }
}
