{
  "appId": "com.zaalis.browser",
  "productName": "zaalis browser",
  "directories": {
    "output": "dist"
  },
  "afterPack": "scripts/afterPack.js",
  "files": [
    "main.js",
    "preload-chrome.js",
    "preload-content.js",
    "interface/**/*",
    "assets/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.utilities",
    "icon": "assets/icon.icns",
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] }
    ],
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "zaalis browser",
    "artifactName": "zaalisBrowser-${version}-${arch}.dmg",
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  }
}
